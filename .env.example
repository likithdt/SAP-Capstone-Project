# AWS IoT Core Configuration
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com
AWS_IOT_THING_NAME=Machine1
AWS_IOT_TOPIC=factory/machines/Machine1/telemetry

# Device Certificates (place in certs/ directory)
AWS_IOT_CERT=certs/device.cert.pem
AWS_IOT_PRIVATE_KEY=certs/device.private.key
AWS_IOT_ROOT_CA=certs/AmazonRootCA1.pem

# DynamoDB Tables
DYNAMODB_TABLE=MachineTelemetry
LATEST_TABLE_NAME=MachineLatestState
